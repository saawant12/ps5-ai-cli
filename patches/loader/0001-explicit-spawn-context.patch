+/* Preserve the upstream interface for its existing callers. */
+pid_t
+elfldr_spawn(int stdin_fd, int stdout_fd, int stderr_fd,
+             uint8_t* elf, char** argv) {
+  char buf[PATH_MAX];
+  const char* cwd = getenv("PWD");
+  if(!cwd && !(cwd = getcwd(buf, sizeof(buf)))) return -1;
