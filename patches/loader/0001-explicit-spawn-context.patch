+static int
+elfldr_copy_fd(pid_t pid, int source, int target) {
+  int remote = pt_rdup(pid, getpid(), source);
+  if(remote < 0) return -1;
+  if(remote == target) return 0;
+  int result = pt_dup2(pid, remote, target);
+  int error = errno;
+  pt_close(pid, remote);
+  errno = error;
+  return result < 0 ? -1 : 0;
+}
 
