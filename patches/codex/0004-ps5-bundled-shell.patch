+#[cfg(target_env = "ps5")]
+fn get_user_shell_path() -> Option<PathBuf> {
+    use std::os::unix::fs::PermissionsExt;
+
+    // Installed by the payload before the CLI starts. PS5's data filesystem
+    // rejects access(X_OK) even for SDK executables launched by our loader.
+    let path = PathBuf::from(std::env::var_os("SHELL")?);
+    let metadata = std::fs::metadata(&path).ok()?;
+    (path.is_absolute() && metadata.is_file() && metadata.permissions().mode() & 0o111 != 0)
+        .then_some(path)
+}
