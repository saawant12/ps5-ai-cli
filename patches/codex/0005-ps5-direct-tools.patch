+#[tokio::test]
+async fn catalog_tool_mode_respects_platform_without_changing_other_metadata() {
+    for tool_mode in [
+        None,
+        Some(ToolMode::Direct),
+        Some(ToolMode::CodeMode),
+        Some(ToolMode::CodeModeOnly),
+    ] {
+        let mut catalog_model = remote_model("native-tools", "Native tools", /*priority*/ 0);
+        catalog_model.tool_mode = tool_mode;
+        let manager = static_manager_for_tests(ModelsResponse {
+            models: vec![catalog_model.clone()],
+        });
+        let config = ModelsManagerConfig {
+            model_context_window: Some(100_000),
+            ..Default::default()
+        };
+
+        let actual = manager.get_model_info("native-tools", &config).await;
+        let mut expected = catalog_model;
+        expected.context_window = Some(100_000);
+        expected.used_fallback_model_metadata = false;
+        if cfg!(target_env = "ps5") {
+            expected.tool_mode = Some(ToolMode::Direct);
+        }
+        assert_eq!(actual, expected);
+    }
+}
 
