+//! PS5 has no Secret Service daemon. Explicit keyring requests must fail.
+//! The existing file and ephemeral authentication stores remain available.
+use super::CredentialStoreError;
+use super::DefaultKeyringStore;
+use super::KeyringStore;
+
+fn unavailable() -> CredentialStoreError {
+    CredentialStoreError::new(keyring::Error::NoStorageAccess(Box::new(
+        std::io::Error::new(
+            std::io::ErrorKind::Unsupported,
+            "PS5 has no native credential keyring; use file or ephemeral credential storage",
+        ),
+    )))
+}
+
+impl KeyringStore for DefaultKeyringStore {
+    fn load(&self, _service: &str, _account: &str) -> Result<Option<String>, CredentialStoreError> {
+        Err(unavailable())
+    }
+
+    fn save(
+        &self,
+        _service: &str,
+        _account: &str,
+        _value: &str,
+    ) -> Result<(), CredentialStoreError> {
+        Err(unavailable())
+    }
+
+    fn delete(&self, _service: &str, _account: &str) -> Result<bool, CredentialStoreError> {
+        Err(unavailable())
+    }
+}
