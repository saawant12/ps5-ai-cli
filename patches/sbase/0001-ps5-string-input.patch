diff --git a/libutil/fshut.c b/libutil/fshut.c
index e596f07..6aedef3 100644
--- a/libutil/fshut.c
+++ b/libutil/fshut.c
@@ -14,14 +14,19 @@ fshut(FILE *fp, const char *fname)
 	 * Leave it unchecked and rely on the following
 	 * functions to detect errors.
 	 */
-	fflush(fp);
+	if (fflush(fp) && fp != stdin) {
+		weprintf("fflush %s:", fname);
+		ret = 1;
+	}
 
 	if (ferror(fp) && !ret) {
 		weprintf("ferror %s:", fname);
 		ret = 1;
 	}
 
-	if (fclose(fp) && !ret) {
+	/* PS5 libc refuses fclose on its three protected standard FILE objects.
+	 * Flush and check them above; process exit releases their descriptors. */
+	if (fp != stdin && fp != stdout && fp != stderr && fclose(fp) && !ret) {
 		weprintf("fclose %s:", fname);
 		ret = 1;
 	}
